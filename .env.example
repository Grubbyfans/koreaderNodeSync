# 服务监听地址与端口（阅读设备通过 http://<本机局域网IP>:PORT 访问）
HOST=0.0.0.0
PORT=8787

# SQLite 数据文件，首次运行自动创建
DB_PATH=./data/koreader.db

# 日志级别：trace | debug | info | warn | error | silent
LOG_LEVEL=info

# 是否允许 KOReader 客户端自行注册账号
ALLOW_REGISTER=true

# 每本书保留的历史进度条数
MAX_HISTORY_PER_BOOK=100

# 是否强制要求原生客户端的 Accept: application/vnd.koreader.v1+json 头
# 默认 false（宽松），设为 true 时缺失/不匹配的请求返回 412
STRICT_ACCEPT=false

# 请求体大小上限（字节）
BODY_LIMIT_BYTES=1048576
